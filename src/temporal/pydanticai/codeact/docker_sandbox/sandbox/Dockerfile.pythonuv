# Python 3.11 with uv package manager
FROM python:3.11-slim

# Install uv using the official installer
RUN apt-get update && apt-get install -y curl && \
    curl -LsSf https://astral.sh/uv/install.sh | sh && \
    ln -s /root/.local/bin/uv /usr/local/bin/uv && \
    ln -s /root/.local/bin/uvx /usr/local/bin/uvx && \
    apt-get remove -y curl && \
    apt-get autoremove -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Add uv to PATH (for interactive shells)
ENV PATH="/root/.local/bin:${PATH}"

# Set environment variables
ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    UV_PYTHON_DOWNLOADS=never \
    UV_PYTHON=python3.11

# Set working directory
WORKDIR /app

# Install pydantic-ai-slim with MCP support and jsonref for MCP tool schema parsing
RUN uv pip install --system "pydantic-ai-slim[mcp]" jsonref

# Make /app read-only to prevent writing there
RUN chmod -R 555 /app

# Create mount point for persistent storage (optional, used when volume is mounted)
RUN mkdir -p /persistent-storage && chmod 777 /persistent-storage

# Create output directory for scripts to write files (for backward compatibility)
RUN mkdir -p /output && chmod 777 /output

# Copy sandbox Python scripts into the container
COPY init_state.py /app/sandbox/init_state.py
COPY get_state.py /app/sandbox/get_state.py
COPY list_variables.py /app/sandbox/list_variables.py
COPY read_variable.py /app/sandbox/read_variable.py
COPY clear_state.py /app/sandbox/clear_state.py
COPY load_state.py /app/sandbox/load_state.py
COPY save_state.py /app/sandbox/save_state.py
COPY mcp_executor.py /app/sandbox/mcp_executor.py
COPY execute_with_mcp.py /app/sandbox/execute_with_mcp.py

# Make execute_with_mcp.py executable
RUN chmod +x /app/sandbox/execute_with_mcp.py

# Default command
CMD ["tail", "-f", "/dev/null"]