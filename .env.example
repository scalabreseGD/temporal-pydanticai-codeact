# Temporal Configuration
TEMPORAL_HOST='localhost:7233'
TEMPORAL_NAMESPACE='default'
TEMPORAL_KEY=your_temporal_jwt_token_here
TEMPORAL_USE_TLS=false

# LLM Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.5-pro

# Optional: Task Queue Configuration
# TASK_QUEUE=sample_queue

# Sandbox Persistence Configuration
# Enable persistent storage for workflow state (default: true)
ENABLE_PERSISTENCE=true

# Volume driver for persistent storage (default: local)
# Options: local, nfs, azure-file-volume, etc.
VOLUME_DRIVER=local

# For NFS-backed persistence (multi-host support), uncomment and configure:
# VOLUME_DRIVER=nfs
# NFS_SERVER=nfs-server.company.com
# NFS_PATH=/exports/workflows